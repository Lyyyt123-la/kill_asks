# ================== 大模型配置（OpenAI 兼容协议） ==================
# 只要填 LLM_API_KEY 就会自动使用真实模型；不填则自动进入「演示模式」（规则版 NL2SQL）。
# 密钥只放在本文件（backend/.env），不要提交到 Git！

# --- 首选：阿里云百炼 DashScope（一个 Key 可调用 Qwen / DeepSeek / GLM / Kimi 等）---
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_API_KEY=

# 百炼上可切换的其他模型（改 LLM_MODEL 即可，需在百炼控制台开通）：
#   qwen-plus / qwen-max / qwen3.8-flash / qwen3.8-max-0902
#   deepseek-v4.1-flash-1017 / deepseek-v4-pro
#   glm-5.2-fast-preview / kimi-k2.8-preview

# --- 备选：智谱 GLM ---
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash

# --- 备选：DeepSeek 官方 ---
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# --- 备选：Kimi（Moonshot） ---
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-8k

# --- 备选：OpenAI ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

LLM_TEMPERATURE=0.1
LLM_TIMEOUT_S=90

# auto = 没有 key 时自动演示模式；on = 强制演示模式；off = 强制调用模型
MOCK_MODE=auto

# ================== 限制参数 ==================
MAX_UPLOAD_MB=30
MAX_ROWS=1000
QUERY_TIMEOUT_S=15
MAX_RETRY=2
MAX_HISTORY_TURNS=3
