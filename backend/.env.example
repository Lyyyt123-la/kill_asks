# ================== 大模型配置（OpenAI 兼容协议） ==================
# 只要填 LLM_API_KEY 就会自动使用真实模型；不填则自动进入「演示模式」（规则版 NL2SQL）。
# 密钥只放在本文件（backend/.env），不要提交到 Git！

# --- 默认：智谱 GLM（推荐 glm-4-flash 便宜 / glm-4-plus 效果更好） ---
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
LLM_API_KEY=

# --- 备选：通义千问 DashScope ---
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# --- 备选：DeepSeek ---
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# --- 备选：Kimi（Moonshot） ---
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-8k

# --- 备选：OpenAI ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

LLM_TEMPERATURE=0.1
LLM_TIMEOUT_S=60

# auto = 没有 key 时自动演示模式；on = 强制演示模式；off = 强制调用模型
MOCK_MODE=auto

# ================== 限制参数 ==================
MAX_UPLOAD_MB=30
MAX_ROWS=1000
QUERY_TIMEOUT_S=15
MAX_RETRY=2
MAX_HISTORY_TURNS=3
